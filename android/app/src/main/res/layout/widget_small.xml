<?xml version="1.0" encoding="utf-8"?>
<!-- 1 × 1 (e "solo Transcri"): lui al centro e, sotto, una parola. -->
<!-- La cornice: la pillola che ritaglia (clipToOutline). Dietro, il gradiente dai token (WidgetColori); sopra, il contenuto. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_phone"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:contentDescription="@string/widget_description">

        <FrameLayout
            android:id="@+id/widget_circle"
            android:layout_width="40dp"
            android:layout_height="36dp">
            <!-- Respira: il ViewFlipper alterna le pose con una dissolvenza (riposo, inspira, riposo, espira). -->
            <ViewFlipper
                android:id="@+id/widget_breath"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:autoStart="true"
                android:flipInterval="1400"
                android:inAnimation="@android:anim/fade_in"
                android:outAnimation="@android:anim/fade_out"
                android:importantForAccessibility="no">
                <ImageView android:id="@+id/widget_blob_1" android:layout_width="34dp" android:layout_height="30dp" android:layout_gravity="center" android:src="@drawable/widget_blob" />
                <ImageView android:id="@+id/widget_blob_2" android:layout_width="37dp" android:layout_height="33dp" android:layout_gravity="center" android:src="@drawable/widget_blob" />
                <ImageView android:id="@+id/widget_blob_3" android:layout_width="34dp" android:layout_height="30dp" android:layout_gravity="center" android:src="@drawable/widget_blob" />
                <ImageView android:id="@+id/widget_blob_4" android:layout_width="32dp" android:layout_height="28dp" android:layout_gravity="center" android:src="@drawable/widget_blob" />
            </ViewFlipper>
            <ImageView
                android:id="@+id/widget_away"
                android:layout_width="34dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:alpha="0.4"
                android:src="@drawable/widget_away"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Detta"
            android:textColor="@color/widget_phone_text"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
