<?xml version="1.0" encoding="utf-8"?>
<!-- La casa di Transcri sulla home: 2 × 1 di partenza, si stringe fino a 1 × 1. Si personalizza
     (colore, scritta, sfondo) quando lo aggiungi e, dopo, tenendolo premuto. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="57dp"
    android:minHeight="57dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:maxResizeHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:configure="com.pasao.transcrify.WidgetSettings"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:initialLayout="@layout/widget_wide"
    android:previewLayout="@layout/widget_wide"
    android:description="@string/widget_description" />
